# Discord Bot Configuration (.env is REQUIRED — the bot refuses to boot without it)
DISCORD_TOKEN=<put your discord_token here>
CLIENT_ID=<put your client_id here>

# Channel lock: prefix (.l/.l2/.deobfuscate) commands only work here
# Channel lock: ONLY these channels may use bot commands (comma-separated,
# no spaces needed). Legacy single-ID ALLOWED_CHANNEL_ID still works as a
# fallback when this is unset.
ALLOWED_CHANNEL_IDS=1555726032584179712,1555948338602442764

# Owner gate: the `.lua` obfuscation command (owner-only beta) only runs for
# this Discord user ID. Unset means nobody may run it (fail closed).
# OWNER_ID=123456789012345678

# Lune tracer (prefix .l/.l2 run these with `lune run` — never any binary)
LUNE_BIN=<put your lune_bin here>
# Defaults already point at ../nita.lua and ../nitav2.lua; uncomment to override:
# NITA_V1_PATH=/app/test/nita.lua
# NITA_V2_PATH=/app/test/nitav2.lua

# LeakD deobfuscation API (used by .deobfuscate / .detect / .luraph).
# Get a key at https://discord.gg/AwGHNh7Z7T — docs: https://leakd.vercel.app/api
# Sent as `X-Api-Key` header to LEAKD_API_BASE_URL. Never commit your real key.
LEAKD_API_KEY=<put your leakd_api_key here>
LEAKD_API_BASE_URL=<put your leakd_api_base_url here>

# Deprecated: old Bearer-token API (replaced by LeakD above). Kept as a
# fallback key source only — UPLOAD_API_TOKEN is used only if LEAKD_API_KEY
# is unset. Remove once your .env has LEAKD_API_KEY.
# UPLOAD_API_TOKEN=your_deobfuscate_api_token_here
# DEOBFUSCATE_API_URL=https://lua-obfuscator-bot.fly.dev/api/deobfuscate

# Pastefy upload for watermarked clean results (.l/.l2) — anonymous, no token.
# PASTEFY_URL=https://pastefy.app

# ---- Daily changelog webhook (optional) -------------------------------------
# Posts a daily digest of what changed to a Discord webhook: additions,
# improvements, fixes and removals. Entries live in ../changelog/entries.jsonl
# (record one with:  node src/lib/changelog.js --add --kind improved --what "…")
#
#   node src/lib/changelog.js --dry-run   # preview today, post nothing
#   node src/lib/changelog.js --now       # post immediately
#
# CHANGELOG_WEBHOOK_URL is a SECRET — anyone holding it can post as this bot.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Leave unset to keep the feature off entirely.
# CHANGELOG_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace_with_your_token
# CHANGELOG_ENABLED=1
# CHANGELOG_INTERVAL_MS=86400000
# CHANGELOG_EMBED=1
# CHANGELOG_USERNAME=Nita Bot Changelog
# Only set this to post through a self-hosted proxy or a local mock; it removes
# the guarantee that only Discord receives the payload.
# CHANGELOG_WEBHOOK_ALLOW_HOST=discord.com,discordapp.com

# Publish deobfuscated results to Pastefy as well as attaching them.
# Set to 0 to disable (the result still arrives as a Discord attachment).
# PASTEFY_ENABLED=1

# ---- Obfuscator auto-detection after .get -----------------------------------
# After `.get` fetches a chain, the biggest scripts are sent to LeakD /detect
# so the reply names the obfuscator and the best next command. Disable with
# LEAKD_DETECT_ON_GET=0, or per-run with `--no-detect` in the message.
# Sends fetched source to the LeakD API — skip it for anything sensitive.
# LEAKD_DETECT_ON_GET=1
# LEAKD_DETECT_MAX=3
